---
import Base from './Base.astro';
import { noteUrl, STAGE_LABEL, COLLECTION_LABEL } from '../lib/garden';
import type { GardenNote, NoteRef, GardenCollection } from '../lib/garden';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  note: GardenNote;
  backlinks: NoteRef[];
  headings: Heading[];
}

const { note, backlinks, headings } = Astro.props;
const { title, stage, tags, date, modified, kind, description } = note.data;
const isDropCap = kind === 'prose';

const formatDate = (d: Date | undefined) => d?.toISOString().split('T')[0];
const fmt = (d: Date | undefined) => d?.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const dateStr = formatDate(date);
const modifiedStr = formatDate(modified);

const siteUrl = 'https://ravenz3.github.io';
const noteCanonical = `${siteUrl}/${note.collection}/${note.slug}`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description ?? '',
  url: noteCanonical,
  author: {
    '@type': 'Person',
    name: 'Ramjan Khandelwal',
    url: `${siteUrl}/about`,
  },
  ...(date ? { datePublished: date.toISOString() } : {}),
  ...(modified ? { dateModified: modified.toISOString() } : date ? { dateModified: date.toISOString() } : {}),
  keywords: tags?.join(', ') ?? '',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: note.collection, item: `${siteUrl}/${note.collection}` },
    { '@type': 'ListItem', position: 3, name: title, item: noteCanonical },
  ],
};

// Build numbered TOC — h2, h3, h4
interface TocItem { heading: Heading; label: string; }
const tocItems: TocItem[] = [];
let h2Count = 0;
let h3Count = 0;
let h4Count = 0;

for (const h of headings.filter(h => h.slug !== 'footnote-label')) {
  if (h.depth === 2) {
    h2Count++;
    h3Count = 0;
    h4Count = 0;
    tocItems.push({ heading: h, label: `${h2Count}` });
  } else if (h.depth === 3) {
    h3Count++;
    h4Count = 0;
    tocItems.push({ heading: h, label: `${h2Count}.${h3Count}` });
  } else if (h.depth === 4) {
    h4Count++;
    tocItems.push({ heading: h, label: `${h2Count}.${h3Count}.${h4Count}` });
  }
}
---
<Base
  title={title}
  description={description}
  activeNav={note.collection === "projects" ? "projects" : "writing"}
  canonicalUrl={noteCanonical}
  ogType="article"
  publishedTime={date?.toISOString()}
  modifiedTime={(modified ?? date)?.toISOString()}
  tags={tags}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>
  <div class="read-progress" id="read-progress" aria-hidden="true"></div>

  <div class="note">
    <aside class="note-toc">
      {tocItems.length > 0 && (
        <nav class="toc" aria-label="Contents">
          <p class="toc-label">Contents</p>
          <ol>
            {tocItems.map(item => (
              <li class={`depth-${item.heading.depth}`}>
                <a href={`#${item.heading.slug}`}>{item.heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </aside>

    <article class="note-main">
      <header class="note-header">
        <p class="note-kicker"><a href={`/${note.collection}`}>{COLLECTION_LABEL[note.collection]}</a></p>
        <h1 class="note-title">{title}</h1>
        {description && <p class="note-description">{description}</p>}
        <div class="note-meta">
          {dateStr && <time datetime={dateStr}>{fmt(date)}</time>}
          {modifiedStr && modifiedStr !== dateStr && <span>Updated {fmt(modified)}</span>}
          <span title="How finished this note is">{STAGE_LABEL[stage]}</span>
          {tags && tags.length > 0 && tags.map(tag => <a href={`/tags/${tag}`}>#{tag}</a>)}
        </div>
      </header>

      <div class:list={['prose', isDropCap && 'drop-cap']}>
        <slot />
      </div>

      {backlinks.length > 0 && (
        <section class="note-links" aria-labelledby="linked-from">
          <h2 id="linked-from">Linked from</h2>
          <ul>
            {backlinks.map(link => (
              <li><a href={noteUrl(link.collection as GardenCollection, link.slug)}>{link.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      <p class="note-back"><a href={`/${note.collection}`}>All {COLLECTION_LABEL[note.collection].toLowerCase()}</a></p>
    </article>

    <aside class="note-side">
      <div id="sidenote-column"></div>
    </aside>
  </div>
</Base>

<script>
  import '../scripts/sidenotes.js';

  const bar = document.getElementById('read-progress');
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  const heads = tocLinks
    .map(a => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((h): h is HTMLElement => !!h && h.offsetParent !== null);

  function onScroll() {
    const el = document.documentElement;
    const max = el.scrollHeight - el.clientHeight;
    if (bar) bar.style.width = (max > 0 ? (el.scrollTop / max) * 100 : 0) + '%';

    const line = window.scrollY + window.innerHeight * 0.25;
    let current = -1;
    heads.forEach((h, i) => { if (h.offsetTop <= line) current = i; });
    tocLinks.forEach((a, i) => a.classList.toggle('is-active', heads[current] && a.hash.slice(1) === heads[current].id));
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
