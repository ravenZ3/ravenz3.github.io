---
import PixelIcon from './PixelIcon.astro';
import { contacts } from '../data/contact';
const shown = contacts.filter(c => c.href);
---
<ul class="contact" aria-label="Contact">
  {shown.map(c => (
    <li>
      <a href={c.href} title={c.value} {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
        <PixelIcon name={c.icon} size={14} />
        <span>{c.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .contact { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.7rem 0.35rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.76rem;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .contact a:hover { border-color: var(--muted); background: var(--surface); }
</style>
