---
// 11x11 pixel-art icons, drawn as one rect per lit pixel.
interface Props { name: 'github' | 'linkedin' | 'x' | 'mail' | 'phone'; size?: number }
const { name, size = 22 } = Astro.props;

const GRIDS: Record<Props['name'], string[]> = {
  github: [
    '.#.......#.',
    '.##.....##.',
    '.#########.',
    '###########',
    '###.###.###',
    '###.###.###',
    '###########',
    '.#########.',
    '...#####...',
    '..#.###.#..',
    '....###....',
  ],
  linkedin: [
    '.#########.',
    '###########',
    '#..########',
    '###########',
    '#..#.....##',
    '#..#..#..##',
    '#..#..#..##',
    '#..#..#..##',
    '#..#..#..##',
    '###########',
    '.#########.',
  ],
  x: [
    '##.......##',
    '###.....###',
    '.###...###.',
    '..###.###..',
    '...#####...',
    '....###....',
    '...#####...',
    '..###.###..',
    '.###...###.',
    '###.....###',
    '##.......##',
  ],
  mail: [
    '...........',
    '###########',
    '##.......##',
    '#.#.....#.#',
    '#..#...#..#',
    '#...#.#...#',
    '#....#....#',
    '#.........#',
    '#.........#',
    '###########',
    '...........',
  ],
  phone: [
    '.###.......',
    '#####......',
    '#####......',
    '.###.......',
    '..##.......',
    '..###......',
    '...###.....',
    '....###.##.',
    '.....######',
    '......#####',
    '.......###.',
  ],
};

const rects: { x: number; y: number }[] = [];
GRIDS[name].forEach((row, y) => [...row].forEach((c, x) => { if (c === '#') rects.push({ x, y }); }));
---
<svg class="pixel-icon" width={size} height={size} viewBox="0 0 11 11" shape-rendering="crispEdges" aria-hidden="true">
  {rects.map(r => <rect x={r.x} y={r.y} width="1" height="1" fill="currentColor" />)}
</svg>
