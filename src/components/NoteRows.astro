---
import { noteUrl, STAGE_LABEL } from '../lib/garden';
import type { GardenNote } from '../lib/garden';

interface Props {
  notes: GardenNote[];
  showDesc?: boolean;
}
const { notes, showDesc = true } = Astro.props;
const fmt = (d?: Date) => d?.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<ul class="rows">
  {notes.map(n => (
    <li class="row">
      <a class="row-title" href={noteUrl(n.collection, n.slug)}>{n.data.title}</a>
      <span class="row-meta">{n.data.date ? fmt(n.data.date) : STAGE_LABEL[n.data.stage]}</span>
      {showDesc && n.data.description && <span class="row-desc">{n.data.description}</span>}
    </li>
  ))}
</ul>
