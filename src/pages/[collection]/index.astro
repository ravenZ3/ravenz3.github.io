---
import Base from '../../layouts/Base.astro';
import NoteRows from '../../components/NoteRows.astro';
import { getAllNotes, COLLECTIONS, COLLECTION_LABEL, COLLECTION_DESC } from '../../lib/garden';
import type { GardenCollection } from '../../lib/garden';

export async function getStaticPaths() {
  // /projects has its own page (src/pages/projects.astro)
  return COLLECTIONS.filter(c => c !== 'projects').map(collection => ({ params: { collection } }));
}

const { collection } = Astro.params as { collection: GardenCollection };
const notes = (await getAllNotes())
  .filter(n => n.collection === collection)
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
const label = COLLECTION_LABEL[collection];
---
<Base title={label} description={COLLECTION_DESC[collection]} activeNav="writing">
  <div class="page">
    <h1 class="page-title">{label}</h1>
    <p class="page-lead">{COLLECTION_DESC[collection]}</p>
    {notes.length > 0
      ? <NoteRows notes={notes} />
      : <p class="page-lead">Nothing published here yet.</p>}
    <p class="page-more" style="margin-top:2rem"><a href="/writing">All writing</a></p>
  </div>
</Base>
