---
import Base from '../layouts/Base.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import Contact from '../components/Contact.astro';
import { featured, more } from '../data/projects';
import { getAllNotes, noteUrl } from '../lib/garden';

const notes = (await getAllNotes())
  .filter(n => n.collection !== 'projects')
  .filter(n => n.data.date)
  .sort((a, b) => b.data.date!.getTime() - a.data.date!.getTime())
  .slice(0, 5);

const kind: Record<string, string> = {
  papers: 'Paper notes',
  literary: 'Prose',
  reflections: 'Essay',
  finance: 'Finance',
};
---
<Base title="ravenZ3" activeNav="home" description="Ramjan Khandelwal builds things to understand them: a Redis server in C++, an agent-driven image editor, a RAG evaluation gate, and writing on papers and ideas.">
  <div class="home">

    <section class="intro" aria-labelledby="intro-name">
      <img class="mascot mascot-deer" src="/images/mascots/deer.gif" alt="" width="500" height="600" />
      <h1 id="intro-name" class="intro-name">Ramjan Khandelwal</h1>
      <p class="intro-lead">I build things to understand them.</p>
      <dl class="intro-qa">
        <div>
          <dt>How do you know an agent was right for the right reason?</dt>
          <dd>You <a href="#agentic-rag-eval-harness">score the path it took</a>, not just the answer.</dd>
        </div>
        <div>
          <dt>Can an LLM edit photos the same way twice?</dt>
          <dd>Only if it <a href="#pixel-flow">writes a graph</a>, not pixels.</dd>
        </div>
        <div>
          <dt>How does Redis serve thousands of clients on one thread?</dt>
          <dd>I <a href="#rediscpp">wrote one in C++</a> and measured it.</dd>
        </div>
      </dl>
      <p class="intro-body">Open to ML engineer, AI engineer, and forward deployed engineer roles.</p>
    </section>

    <Contact />

    <section class="block" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="block-title block-title-mascot">Projects <img class="mascot mascot-cat" src="/images/mascots/cat-hummingbird.gif" alt="" width="250" height="250" /></h2>
      {featured.slice(0, 2).map(p => <ProjectEntry project={p} />)}
      {featured.slice(2).map(p => <ProjectEntry project={p} compact />)}
      <p class="block-more"><a href="/projects">Project details and smaller builds</a></p>
    </section>

    <section class="block" aria-labelledby="also-heading">
      <h2 id="also-heading" class="block-title">Also built</h2>
      <ul class="also">
        {more.map(m => (
          <li>
            <a href={m.repo} target="_blank" rel="noopener">{m.name}</a>
            <span>{m.summary}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="block" aria-labelledby="writing-heading">
      <h2 id="writing-heading" class="block-title">Recent writing</h2>
      <ul class="writing">
        {notes.map(n => (
          <li>
            <a href={noteUrl(n.collection, n.slug)}>{n.data.title}</a>
            <span>{kind[n.collection] ?? n.collection}</span>
          </li>
        ))}
      </ul>
      <p class="block-more"><a href="/writing">All writing</a></p>
    </section>

  </div>
</Base>

<style>
  .home {
    max-width: 46rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
    width: 100%;
    font-family: var(--display);
  }

  .intro { padding-bottom: 2rem; position: relative; }
  .mascot { image-rendering: pixelated; pointer-events: none; user-select: none; }
  .mascot-deer {
    position: absolute;
    right: 0;
    top: -0.6rem;
    width: auto;
    height: 6.5rem;
  }
  .block-title-mascot { display: flex; justify-content: space-between; align-items: flex-end; }
  .mascot-cat { width: auto; height: 4.5rem; margin-bottom: -0.3rem; }
  @media (max-width: 600px) {
    .mascot-deer { height: 4.2rem; top: -0.3rem; }
    .intro-name { padding-right: 4.5rem; }
    .mascot-cat { height: 3.6rem; }
  }
  .intro-name {
    font-family: var(--pixel);
    font-size: clamp(3rem, 11vw, 4.8rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 0.92;
    color: var(--text);
    margin: 0 0 0.5rem;
  }
  .intro-lead {
    font-family: var(--subhead);
    font-size: clamp(1.6rem, 4.5vw, 2.1rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.2;
    color: var(--text);
    margin: 0 0 1.25rem;
    max-width: 32ch;
  }
  .intro-qa { margin: 0 0 1.25rem; display: grid; gap: 0.6rem; max-width: 52ch; }
  .intro-qa dt { font-family: var(--subhead); font-size: 1.2rem; font-weight: 400; line-height: 1.3; color: var(--text); }
  .intro-qa dd { margin: 0; font-size: 0.92rem; line-height: 1.55; color: var(--muted); }
  .intro-qa a { color: var(--text); font-weight: 500; text-decoration: none; text-decoration-color: var(--faint); text-underline-offset: 4px; }
  .intro-qa a:hover { color: var(--muted); text-decoration-color: var(--text); }
  .intro-body {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0 0 0.6rem;
    max-width: 56ch;
  }
  .intro-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    font-size: 0.82rem;
  }
  .intro-body a, .block-more a, .also a, .writing a {
    color: var(--text);
    text-decoration: none;
    text-decoration-color: var(--faint);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .intro-body a:hover, .block-more a:hover, .also a:hover, .writing a:hover {
    color: var(--muted);
  }

  .block { padding-top: 0.5rem; }
  .block + .block { padding-top: 2rem; }
  .block-title {
    font-family: var(--subhead);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--text);
    letter-spacing: 0;
    line-height: 1.2;
    margin: 0 0 0.25rem;
  }
  .block-more { font-size: 0.82rem; margin: 0; padding-top: 0.75rem; border-top: 1px solid var(--border); }

  .also, .writing { list-style: none; padding: 0; margin: 0.25rem 0 0; }
  .also li, .writing li {
    display: grid;
    gap: 0.1rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .also li span { color: var(--muted); font-size: 0.82rem; max-width: 62ch; }
  .writing li {
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 1rem;
  }
  .writing li span { color: var(--faint); font-size: 0.75rem; white-space: nowrap; }

  @media (max-width: 600px) {
    .home { padding: 1.75rem 1rem 2.5rem; }
  }
</style>
