---
import Base from '../../layouts/Base.astro';
import NoteRows from '../../components/NoteRows.astro';
import { getAllNotes } from '../../lib/garden';

export async function getStaticPaths() {
  const all = await getAllNotes();
  const tags = new Set(all.flatMap(n => n.data.tags));
  return [...tags].map(tag => ({
    params: { tag },
    props: {
      tag,
      notes: all
        .filter(n => n.data.tags.includes(tag))
        .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)),
    },
  }));
}
const { tag, notes } = Astro.props;
---
<Base title={`#${tag}`} description={`${notes.length} ${notes.length === 1 ? 'note' : 'notes'} tagged ${tag}.`} activeNav="writing">
  <div class="page">
    <h1 class="page-title">#{tag}</h1>
    <p class="page-lead">{notes.length} {notes.length === 1 ? 'note' : 'notes'}</p>
    <NoteRows notes={notes} />
    <p class="page-more" style="margin-top:2rem"><a href="/tags">All tags</a></p>
  </div>
</Base>
