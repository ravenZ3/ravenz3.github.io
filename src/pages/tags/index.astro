---
import Base from '../../layouts/Base.astro';
import { getAllNotes } from '../../lib/garden';

const all = await getAllNotes();
const counts = new Map<string, number>();
for (const n of all) for (const t of n.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---
<Base title="Tags" description={`Notes by Ramjan Khandelwal grouped by ${tags.length} topics.`} activeNav="writing">
  <div class="page">
    <h1 class="page-title">Tags</h1>
    <p class="page-lead">Every note, grouped by topic.</p>
    <ul class="rows">
      {tags.map(([tag, count]) => (
        <li class="row">
          <a class="row-title" href={`/tags/${tag}`}>#{tag}</a>
          <span class="row-meta">{count} {count === 1 ? 'note' : 'notes'}</span>
        </li>
      ))}
    </ul>
  </div>
</Base>
